# ==============================================================================
# Douyin / TikTok Dubbing Studio Environment Configuration Template
# Copy this file to .env and fill in your API keys
# ==============================================================================

# Gemini API Keys (Single key or comma-separated pool for automatic rotation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=key1,key2,key3

# Kokoro TTS Engine ONNX Models & Voices (Optional overrides)
KOKORO_MODEL_PATH=C:\Users\rudra\PycharmProjects\captions videos maker\kokoro-v1.0.onnx
KOKORO_VOICES_PATH=C:\Users\rudra\PycharmProjects\captions videos maker\voices-v1.0.bin

# Sarvam AI API Configuration (Bulbul v3 Native Hindi/Hinglish Voiceovers)
SARVAM_API_KEY=your_sarvam_api_key_here

# Video Registry (SQLite index of downloads, renders, Drive copies & movies)
# Defaults: output/video_registry.db with snapshots in output/video_registry/
# Override the database location:
# VIDEO_REGISTRY_DB=C:\path\to\video_registry.db
# Mirror JSON/CSV/DB snapshots into a specific Drive folder:
# VIDEO_REGISTRY_DRIVE_DIR=I:\My Drive\douyin\video_registry
# Disable auto snapshot export after each write (1/true):
# VIDEO_REGISTRY_NO_EXPORT=0
# Disable copying snapshots to Google Drive (1/true):
# VIDEO_REGISTRY_NO_DRIVE=0

